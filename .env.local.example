# --- Supabase (required) ---
# Supabase dashboard -> Project Settings -> API: Project URL and the service_role key (server only, never in the browser).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- Accounts / Supabase Auth (agent A) ---
# 1 = require sign-in (also means db/migrations/002_accounts.sql is applied). Unset = app works as today.
AUTH_ENABLED=
# Supabase dashboard -> Project Settings -> API (Project URL and the "anon" / publishable key; never the service_role key)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# 1 = self-service "Forgot password?" by email (needs working email/SMTP). Unset = users ask the admin.
AUTH_PASSWORD_RESET=

# --- Bring-your-own-key + uploads (agent B) ---
# Encrypts each user's saved Gemini key (AES-256-GCM). 32 random bytes, base64. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Keep it stable: changing it makes every saved user key unreadable (users must re-enter them).
KEY_ENCRYPTION_SECRET=
# Used only while AUTH_ENABLED is unset (with accounts on, each user's own saved key is used instead).
# GEMINI_API_KEY=
# Direct browser uploads go to the private 'documents' Storage bucket created by
# db/migrations/002_accounts.sql; no extra variable is needed (SUPABASE_URL / SUPABASE_SERVICE_ROLE_KEY above).

# --- Publishing (agent C) ---
# Optional custom base domain for published sites (e.g. stories.example.com). Unset = <prefix><name>.vercel.app.
PUBLISH_BASE_DOMAIN=
# Optional override of the fixed site-name prefix (default "warpdrive-"): sites publish at <prefix><name>.vercel.app.
PUBLISH_NAME_PREFIX=
# The hosted app's own URL; published-bundle assets missing from the function filesystem are fetched from here.
APP_BASE_URL=
# Vercel token (and team id if the token belongs to a team) used to deploy published sites.
VERCEL_TOKEN=
VERCEL_TEAM_ID=

# --- Text-to-speech (agent D) ---
# edge   = in-process Microsoft Edge voices, no separate server (works on Vercel). Default when TTS_SERVER_URL is unset.
# server = the external text-to-voice server below. Default when TTS_SERVER_URL is set (the original local setup).
TTS_PROVIDER=
# Only for TTS_PROVIDER=server. Leave both unset on Vercel.
# TTS_SERVER_URL=
# TTS_API_KEY=

# --- Domains, generated images, company logos, Drive backup (see docs/DOMAINS_PLAN.md) ---
# Needs db/migrations/003_domains_images.sql applied. Without it the app hides the domain dropdown and makes no images.
# Google Drive backup (optional; skipped silently when either is missing). Setup: docs/DRIVE_SETUP.md
# GOOGLE_SERVICE_ACCOUNT_JSON=
# DRIVE_FOLDER_ID=
# FREE image generation via Cloudflare Workers AI (FLUX.2 klein). When both are set, ALL users
# generate through it and need no personal image key. Free plan: 10,000 Neurons/day (about 80 images).
# Account ID: Cloudflare dashboard > Workers & Pages (right column). Token: My Profile > API Tokens >
# Create Token > "Workers AI" template (or custom: Account > Workers AI > Read + Edit).
# CLOUDFLARE_ACCOUNT_ID=
# CLOUDFLARE_API_TOKEN=
# CLOUDFLARE_IMAGE_MODEL=@cf/black-forest-labs/flux-2-klein-4b
# Optional image model overrides (defaults live in src/lib/imageGen, in one place)
# GEMINI_IMAGE_MODEL=
# OPENAI_IMAGE_MODEL=

# --- Templates ---
# Optional, comma-separated template ids to hide from the picker and block from preview/publish
# (e.g. DISABLED_TEMPLATES=airlock,lunar). Already-published sites are static files and are unaffected.
# Projects that still point at a hidden template show "Template no longer available: choose another".
# Permanent switch: `enabled: false` in src/lib/templates.ts. See docs/REMOVING_TEMPLATES.md.
# DISABLED_TEMPLATES=

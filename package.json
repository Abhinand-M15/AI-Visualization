{
  "name": "story-site-generator",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "predev": "node scripts/check-dev-env.mjs",
    "dev": "next dev -H 127.0.0.1",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check:env": "node scripts/check-dev-env.mjs",
    "build:showcase": "node scripts/build-showcase.mjs",
    "check:showcase": "node scripts/build-showcase.mjs && git diff --exit-code -- public/themes/showcase"
  },
  "dependencies": {
    "@google/genai": "^2.19.0",
    "@react-three/drei": "^10.7.8",
    "@react-three/fiber": "^9.7.0",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.112.4",
    "clsx": "^2.1.1",
    "gsap": "^3.15.0",
    "jszip": "^3.10.1",
    "lenis": "^1.3.26",
    "msedge-tts": "^2.0.8",
    "next": "^16.4.5",
    "pdf-parse": "^2.4.5",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "sharp": "^0.35.5",
    "tailwind-merge": "^3.6.0",
    "three": "^0.185.1",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "esbuild": "^0.28.2",
    "eslint": "^9",
    "eslint-config-next": "^16.4.5",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.12"
  }
}
